# Copy these settings into the analysis host's environment, not the Vercel browser bundle.
BALLFORM_REQUIRE_TOKEN=1
# Set a long random token and enter it into the frontend's Access token field.
BALLFORM_ACCESS_TOKEN=
# Exact browser origins, comma-separated. Add preview origins explicitly if needed.
BALLFORM_CORS_ORIGINS=https://your-project.vercel.app
BALLFORM_JOBS_DIR=/data/jobs
BALLFORM_MODELS_DIR=/data/models
